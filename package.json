{
  "name": "@jidekaixin2dian/dsh-file-actions",
  "version": "0.1.19",
  "description": "Act on files and links in chat: open, reveal, preview or save; choose preferred apps, inspect reference context and copy excerpts with their source.",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg",
    "assets",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "setup:host": "node scripts/setup-host.mjs",
    "test:host": "node scripts/test-host.mjs",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jidekaixin2dian/dsh-file-actions.git"
  },
  "homepage": "https://github.com/jidekaixin2dian/dsh-file-actions#readme",
  "bugs": {
    "url": "https://github.com/jidekaixin2dian/dsh-file-actions/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-menu",
    "file-actions"
  ],
  "author": "jidekaixin2dian",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
